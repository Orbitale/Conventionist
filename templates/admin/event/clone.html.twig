{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    {{ 'Clone event'|trans }}
{% endblock %}

{% block main %}

    <div class="alert alert-info">
        <i class="fas fa-arrow-up"></i> {{ 'calendar.modal.choose_an_event'|trans }}
    </div>

    {% for event in events %}
        <p>{{ event.id }} - {{ event.name }}</p>
    {% endfor %}

{% endblock %}
