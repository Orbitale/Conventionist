{% extends 'base.html.twig' %}

{% block title %}{{ 'My Events'|trans }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ 'My Events'|trans }}</h1>

    {% set group_labels = {
        'confirmed': 'Confirmed',
        'pending':   'Pending',
        'waitlist':  'Waitlist',
        'past':      'Past',
        'cancelled': 'Cancelled',
    } %}

    {% for key, label in group_labels %}
        {% set items = groups[key]|default([]) %}
        <section class="mb-5">
            <h2 class="h5 d-flex align-items-center gap-2">
                {{ label|trans }}
                <span class="badge bg-secondary">{{ items|length }}</span>
            </h2>

            {% if items is empty %}
                <p class="text-muted small mb-0">{{ 'No events in this category.'|trans }}</p>
            {% else %}
                <ul class="list-group">
                    {% for registration in items %}
                        {% set event = registration.event %}
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">{{ event.name }}</div>
                                <div class="text-muted small">
                                    {% if event.startsAt %}{{ event.startsAt|date('Y-m-d') }}{% endif %}
                                    {% if event.endsAt %} — {{ event.endsAt|date('Y-m-d') }}{% endif %}
                                </div>
                            </div>
                            <span class="badge bg-{{ registration.status.cssClass }}">
                                {{ registration.status.value|trans }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% endfor %}
{% endblock %}
